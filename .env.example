# Токен от @BotFather (обязательно)
BOT_TOKEN=

# Кто может пользоваться ботом: Telegram ID через запятую (узнать: написать боту /id)
ALLOWED_USER_IDS=

# Куда складывать видео (по умолчанию ./downloads рядом с ботом)
DOWNLOAD_DIR=

# Присылать скачанное видео обратно в чат
SEND_TO_CHAT=true

# Лимит отправки в чат, МБ. Обычный Telegram Bot API позволяет до 50 МБ.
# Со своим Bot API сервером (см. README, раздел «Большие файлы») до 2000 МБ.
MAX_SEND_MB=
TELEGRAM_API_URL=

# Необязательно: копировать файлы в облако через rclone (Google Drive, Dropbox, Яндекс Диск...)
# Пример: RCLONE_REMOTE=gdrive:Vimeo
RCLONE_REMOTE=

# Необязательно: для видео, доступных только после входа в Vimeo
# COOKIES_FROM_BROWSER=chrome
# COOKIES_FILE=/path/to/cookies.txt
